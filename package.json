{
  "name": "edu-sims-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منصة محاكاة تعليمية مفتوحة لجميع المستخدمين دون تسجيل دخول — Open educational simulation platform",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "sims/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
